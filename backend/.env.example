# ==========================================
# CẤU HÌNH ZALO ZNS — BÙI THƯƠNG MAKEUP
# ==========================================

# 1. Cổng máy chủ (mặc định 3000)
PORT=3000

# 2. Token Zalo Official Account (OA)
# Lấy từ Zalo Developer: https://developers.zalo.me
ZALO_ACCESS_TOKEN=

# 3. Mã Template ZNS đã được Zalo duyệt
# Tạo template tại: https://zalo.cloud/zns
ZALO_TEMPLATE_BOOKING=
ZALO_TEMPLATE_REMINDER=
ZALO_TEMPLATE_STATUS=

# 4. Chế độ chạy thử ZNS (1: Bật chạy thử / 0: Gửi tin thật)
# Đặt = 1 thì hệ thống mô phỏng gửi thành công, không tốn phí ZNS
ZNS_DRY_RUN=1

# 5. Số lần gửi lại tối đa khi lỗi
ZNS_MAX_RETRIES=3

# 6. Tự động nhắc hẹn trước
REMINDER_ENABLED=1
REMINDER_HOURS_AHEAD=24
